<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description | default('Tu alma, tu música - Latina Live Radio. Escucha lo mejor de la música latina en vivo.') }}">
    <meta name="author" content="Sanagui DJ">
    <meta name="robots" content="index, follow">
    
    <meta property="og:title" content="{{ title or 'Latina Live' }}">
    <meta property="og:description" content="{{ description | default('Tu alma, tu música - Latina Live Radio') }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://latinalive.net/">
    <meta property="og:image" content="/img/logo.png">

    <link rel="icon" href="/img/logo.png">
    <link rel="manifest" href="/img/site.webmanifest">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <link rel="stylesheet" href="/css/custom.css">

    <script>
        // Check for saved theme preference (Keeping for compatibility)
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
</head>

<body>
    <header class="site-header" role="banner">
        <img src="/img/logo.png" alt="Logotipo de Latina Live: Un tocadiscos con un disco de oro que dice LATINA LIVE" loading="eager">
        <p class="slogan">Tu alma, tu música</p>
    </header>

    <main id="main-content">
        {{ content | safe }}
    </main>

    <footer class="site-footer" role="contentinfo">
        <p>&copy; 2023 - 2026 Latina Live. Todos los derechos reservados.</p>
        <p style="margin-bottom: 1rem;">Tu alma, tu música. 📻</p>
        <nav aria-label="Enlaces legales" style="display: flex; justify-content: center; gap: 1.5rem; font-size: 0.9rem;">
            <a href="/privacy/" style="color: var(--color-navy); text-decoration: underline;">Política de Privacidad</a>
            <a href="/terminos/" style="color: var(--color-navy); text-decoration: underline;">Términos y Condiciones</a>
        </nav>
    </footer>


    <!-- Persistent Mini-Player Bar -->
    <div id="mini-player-bar" class="persistent-controls hidden" aria-label="Control rápido de radio">
        <div class="mini-info">
            <span id="mini-locutor" style="font-weight: bold;">Latina Live</span>
            <span id="mini-track" style="font-size: 0.75rem; opacity: 0.8;">Sintonizando...</span>
        </div>
        <div class="mini-btns" style="display: flex; align-items: center; gap: 0.8rem;">
            <div class="mini-volume" style="display: flex; align-items: center; gap: 0.4rem;">
                <i class="fas fa-volume-up" style="font-size: 0.8rem;"></i>
                <input type="range" id="miniVolumeSlider" min="0" max="1" step="0.01" value="0.3" aria-label="Volumen mini" style="width: 60px;">
            </div>
            <button id="miniPlayPauseBtn" class="btn-mini" aria-label="Reproducir / Pausar">
                <i class="fas fa-play"></i>
            </button>
            <button onclick="navigateToScreen(1)" class="btn-mini" aria-label="Ir al inicio">
                <i class="fas fa-home"></i>
            </button>
        </div>
    </div>


    <!-- Scripts -->
    <script src="/scripts/player.js" defer></script>
    <script type="module" src="/scripts/notificaciones.js" defer></script>
    <script src="/scripts/sparkles.js" defer></script>
    
    <script>
    // SPA Screen Management
    function showScreen(screenNumber) {
        // Hide all screens
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        // Show target screen
        const target = document.getElementById(`screen-${screenNumber}`);
        if(target) {
            target.classList.add('active');
            window.scrollTo(0, 0);
        }
        
        // Mini-player visibility: Hide on screen 1, show on others
        const miniBar = document.getElementById('mini-player-bar');
        if(miniBar) {
            if(screenNumber == 1) {
                miniBar.classList.add('hidden');
            } else {
                miniBar.classList.remove('hidden');
            }
        }

        // Dynamic focus for accessibility
        const firstElement = target.querySelector('h1, h2, input, button');
        if(firstElement) firstElement.focus();
    }


    // Initialize first screen or from hash
    document.addEventListener('DOMContentLoaded', () => {
        const hash = window.location.hash.replace('#', '');
        if(hash && document.getElementById(`screen-${hash}`)) {
            showScreen(hash);
        } else {
            showScreen(1);
        }

        // Initialize Chat if on screen 2
        // We'll call this when switching to screen 2
    });

    // Navigation overrides
    window.addEventListener('popstate', (event) => {
        if(event.state && event.state.screen) {
            showScreen(event.state.screen);
        }
    });

    function navigateToScreen(n) {
        history.pushState({screen: n}, `Screen ${n}`, `#${n}`);
        showScreen(n);
        
        if(n === 2) {
            initChatOnScreen2();
        }
    }

    async function initChatOnScreen2() {
        const chatBox = document.getElementById('chat-box');
        if(chatBox) {
            try {
                const module = await import('/scripts/chat.js');
                if(module && module.initChat) {
                    module.initChat();
                }
            } catch(e) {
                console.error("Chat script failed", e);
            }
        }
    }

    // Initialize Locutor Update (Persistent)
    async function actualizarLocutor() {
        try {
            // RESTAURADO: Ruta absoluta
            const respuesta = await fetch('https://latinalive.net/api/estado');
            const datos = await respuesta.json();
            const locutorEl = document.getElementById('nombre-locutor');
            if(locutorEl) locutorEl.innerText = datos.locutor;
        } catch (error) {
            console.log("Locutor update failed", error);
        }
    }

    actualizarLocutor();
    setInterval(actualizarLocutor, 10000);
    </script>
</body>
</html>
